# ========================================
# VARIABLES DE ENTORNO - Sistema de Gestión de Importaciones ESW Cargo
# ========================================

# ------------------------------------------------------------
# BASE DE DATOS (Supabase PostgreSQL)
# ------------------------------------------------------------
# La aplicación usa Supabase como base de datos externa
# NO requiere PostgreSQL local en Docker

# Connection Pooling (Transaction Mode) - Para queries de la app
DATABASE_URL="postgres://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"

# Direct Connection (Session Mode) - Para migraciones de Prisma
DIRECT_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE"

# Ejemplo con tu configuración actual:
# DATABASE_URL="postgres://postgres.bvpcmghxfwmjdngrumou:***REMOVED***@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgres://postgres.bvpcmghxfwmjdngrumou:***REMOVED***@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------
# AUTENTICACIÓN
# ------------------------------------------------------------
# Secreto para NextAuth.js (generar con: openssl rand -base64 32)
AUTH_SECRET="***REMOVED***"

# ------------------------------------------------------------
# SUPABASE (Storage y Servicios)
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://TU_PROYECTO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="TU_ANON_KEY_AQUI"

# ------------------------------------------------------------
# EMAIL (SMTP)
# ------------------------------------------------------------
SMTP_HOST="smtp.tuproveedor.com"
SMTP_PORT="465"
SMTP_USER="tu@email.com"
SMTP_PASS="***REMOVED***"

# ------------------------------------------------------------
# INTELIGENCIA ARTIFICIAL (Google Gemini)
# ------------------------------------------------------------
GEMINI_API_KEY="***REMOVED***"

# ------------------------------------------------------------
# CONFIGURACIÓN DE PRODUCCIÓN
# ------------------------------------------------------------
NODE_ENV="production"
PORT=3000  # Puerto interno del contenedor (no cambiar)

# ========================================
# PUERTOS EXPUESTOS
# ========================================
# Puerto externo del servidor: 3002 (definido en docker-compose.yml)
# Puerto interno del contenedor: 3000
# La aplicación estará disponible en: http://TU_IP:3002
