# ESWCARGO - plantilla sin credenciales reales

# Base de datos
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@POOLER_HOST:5432/postgres"

# Autenticacion
AUTH_SECRET=""

# Sincronizacion de estados de envios con Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=""
