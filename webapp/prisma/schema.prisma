generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id              Int                  @id @default(autoincrement())
  old_id          Int?                 @unique
  name            String
  document_id     String?
  email           String?
  phone           String?
  instagram       String?
  webpage         String?
  address         String?
  type            String?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  city            String?
  country         String?
  state           String?
  zipCode         String?
  userId          String?              @unique
  segment         String?
  canAccess       Boolean              @default(true)
  active          Boolean              @default(true)
  phone2          String?
  user            User?                @relation(fields: [userId], references: [id])
  orders          Order[]
  shipments       Shipment[]
  transactions    Transaction[]
  allocations     PurchaseAllocation[]
  accountEvidence AccountEvidence[]
}

model User {
  id        String   @id @default(cuid())
  name      String?
  username  String?  @unique
  email     String?  @unique
  password  String?
  role      String   @default("CLIENT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client?
}

model Product {
  id                 Int            @id @default(autoincrement())
  sku                String         @unique
  name               String
  color_grade        String?
  type               String?
  model              String?
  brand              String?
  weight             Float?
  volum              Float?
  status             String?
  last_purchase_cost Float?
  active             Boolean        @default(true)
  webpage            String?
  lp1                Float?
  lp2                Float?
  lp3                Float?
  description        String?
  stock              Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  imageUrl           String?
  orderItems         OrderItem[]
  purchaseItems      PurchaseItem[]
  ingestionItems     IngestionItem[]
  supplierOffers     SupplierOffer[]
}

model SparePart {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  name        String
  description String?
  cost        Float?
  price       Float?
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Supplier {
  id           Int           @id @default(autoincrement())
  name         String
  contact      String?
  email        String?
  phone        String?
  address      String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  city         String?
  country      String?
  state        String?
  zipCode      String?
  old_id       Int?          @unique
  orderItems   OrderItem[]
  purchases    Purchase[]
  transactions Transaction[]
  ingestionRuns IngestionRun[]
  supplierOffers SupplierOffer[]
}

/// Raw, immutable supplier input and its processing lifecycle.
model IngestionRun {
  id             String          @id @default(cuid())
  sourceType     String          @default("text")
  rawText        String
  contentHash    String
  idempotencyKey String?         @unique
  receivedAt     DateTime
  status         String          @default("PROCESSING")
  supplierId     Int?
  supplierName   String?
  model          String?
  errorMessage   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  items          IngestionItem[]

  @@index([receivedAt])
  @@index([status])
  @@index([contentHash, createdAt])
}

/// One validated extraction from an ingestion run, optionally matched to the catalog.
model IngestionItem {
  id                  String         @id @default(cuid())
  ingestionRunId      String
  lineNumber          Int
  rawLine             String
  productName         String?
  exactModel          String?
  capacity            String?
  color               String?
  condition           String?
  region              String?
  costUsd             Float?
  availability        String?
  quantity            Int?
  observations        String?
  normalizedProductId Int?
  matchConfidence     Float?
  reviewRequired      Boolean        @default(true)
  reviewReason        String?
  extractedData       Json
  createdAt           DateTime       @default(now())
  ingestionRun        IngestionRun   @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)
  normalizedProduct   Product?       @relation(fields: [normalizedProductId], references: [id])
  offer               SupplierOffer?

  @@unique([ingestionRunId, lineNumber])
  @@index([normalizedProductId])
  @@index([reviewRequired])
}

/// A supplier cost observation. It never changes Product selling prices or purchases.
model SupplierOffer {
  id              String        @id @default(cuid())
  ingestionItemId String        @unique
  supplierId      Int
  productId       Int
  costUsd         Float
  quantity        Int?
  availability    String?
  observedAt      DateTime
  createdAt       DateTime      @default(now())
  ingestionItem   IngestionItem @relation(fields: [ingestionItemId], references: [id], onDelete: Cascade)
  supplier        Supplier      @relation(fields: [supplierId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])

  @@index([supplierId, productId, observedAt])
}

model Order {
  id              Int                   @id @default(autoincrement())
  order_number    Int?                  @unique
  clientId        Int
  date            DateTime
  status          String
  total_amount    Float
  currency        String                @default("USD")
  notes           String?
  forwarder       String?
  tracking_number String?
  shipmentId      Int?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  type            String?
  paymentMethod   String?
  email_sent_at   DateTime?
  source          String?
  client          Client                @relation(fields: [clientId], references: [id])
  shipment        Shipment?             @relation(fields: [shipmentId], references: [id])
  items           OrderItem[]
  allocations     PurchaseAllocation[]
  submissionGuard OrderSubmissionGuard?
}

model OrderSubmissionGuard {
  id            Int      @id @default(autoincrement())
  submissionKey String   @unique
  orderId       Int      @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model OrderItem {
  id               Int                  @id @default(autoincrement())
  orderId          Int
  productId        Int?
  productName      String
  quantity         Int
  unit_price       Float
  unit_cost        Float
  shipping_cost    Float?
  subtotal         Float
  profit           Float                @default(0)
  supplierId       Int?
  purchase_invoice String?
  shipmentId       Int?
  status           String?
  order            Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product?             @relation(fields: [productId], references: [id])
  shipment         Shipment?            @relation(fields: [shipmentId], references: [id])
  supplier         Supplier?            @relation(fields: [supplierId], references: [id])
  allocations      PurchaseAllocation[]
}

model Transaction {
  id              Int                 @id @default(autoincrement())
  clientId        Int?
  date            DateTime
  type            String
  amount          Float
  description     String?
  reference       String?
  createdAt       DateTime            @default(now())
  paymentMethod   String?
  supplierId      Int?
  client          Client?             @relation(fields: [clientId], references: [id])
  supplier        Supplier?           @relation(fields: [supplierId], references: [id])
  receipt         PaymentReceipt?
  paymentGuard    ClientPaymentGuard?
  accountEvidence AccountEvidence[]
}

model ClientPaymentGuard {
  id            Int         @id @default(autoincrement())
  clientId      Int
  paymentDate   DateTime    @db.Date
  amount        Float
  referenceKey  String
  transactionId Int         @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([clientId, paymentDate, amount, referenceKey])
}

model SyncRun {
  id         Int          @id @default(autoincrement())
  scope      String
  status     String
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  summary    Json?
  error      String?
  changes    SyncChange[]

  @@index([startedAt])
  @@index([status])
}

model SyncChange {
  id        Int      @id @default(autoincrement())
  syncRunId Int
  entity    String
  entityKey String
  action    String
  reason    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  syncRun   SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  @@index([syncRunId])
  @@index([entity, entityKey])
  @@index([action])
}

model PaymentReceipt {
  id            Int         @id @default(autoincrement())
  transactionId Int         @unique
  fileName      String
  mimeType      String
  size          Int
  sha256        String
  data          Bytes
  createdAt     DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([sha256])
}

model AccountEvidence {
  id                   Int          @id @default(autoincrement())
  clientId             Int
  transactionId        Int?
  transactionReference String?
  transactionDate      DateTime?    @db.Date
  transactionType      String?
  transactionAmount    Float?
  category             String
  note                 String?
  source               String?
  fileName             String?
  mimeType             String?
  size                 Int?
  sha256               String?
  data                 Bytes?
  createdAt            DateTime     @default(now())
  client               Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transaction          Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([transactionId])
  @@index([sha256])
}

model Shipment {
  id                Int         @id @default(autoincrement())
  shipment_number   Int?        @unique
  clientId          Int?
  forwarder         String?
  date_shipped      DateTime?
  date_arrived      DateTime?
  weight_fw         Float?
  weight_cli        Float?
  type_load         String?
  item_count        Int?
  cost_total        Float?
  price_total       Float?
  profit            Float?
  invoice           String?
  status            String
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  email_sent_at     DateTime?
  cargo_description String?
  orders            Order[]
  items             OrderItem[]
  client            Client?     @relation(fields: [clientId], references: [id])
}

model Purchase {
  id             Int            @id @default(autoincrement())
  invoice_number String?        @unique
  date           DateTime
  due_date       DateTime?
  supplierId     Int
  total_amount   Float
  paid_amount    Float          @default(0)
  balance_due    Float          @default(0)
  payment_status String         @default("PENDIENTE")
  paid_at        DateTime?
  payment_method String?
  status         String         @default("ABIERTA")
  receipt_url    String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  items          PurchaseItem[]
}

model PurchasePayment {
  id             Int                   @id @default(autoincrement())
  purchaseId     Int
  supplierId     Int
  date           DateTime              @default(now())
  amount         Float
  payment_method String?
  reference      String?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  paymentGuard   PurchasePaymentGuard?

  @@index([purchaseId, date])
  @@index([supplierId, date])
}

model PurchasePaymentGuard {
  id                Int             @id @default(autoincrement())
  purchaseId        Int
  paymentDate       DateTime        @db.Date
  amount            Float
  referenceKey      String
  purchasePaymentId Int             @unique
  purchasePayment   PurchasePayment @relation(fields: [purchasePaymentId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@unique([purchaseId, paymentDate, amount, referenceKey])
}

model PurchaseItem {
  id                 Int                  @id @default(autoincrement())
  purchaseId         Int
  sku                String?
  productName        String
  quantity           Int
  allocated_quantity Int                  @default(0)
  unit_cost          Float
  subtotal           Float
  purchase           Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product            Product?             @relation(fields: [sku], references: [sku])
  allocations        PurchaseAllocation[]
}

model PurchaseAllocation {
  id                  Int          @id @default(autoincrement())
  purchaseItemId      Int
  clientId            Int
  orderId             Int
  orderItemId         Int
  quantity            Int
  unit_cost_snapshot  Float
  unit_price_snapshot Float
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  client              Client       @relation(fields: [clientId], references: [id])
  order               Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem           OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  purchaseItem        PurchaseItem @relation(fields: [purchaseItemId], references: [id], onDelete: Cascade)

  @@index([purchaseItemId])
  @@index([clientId])
  @@index([orderId])
  @@index([orderItemId])
}

model Expense {
  id            Int      @id @default(autoincrement())
  date          DateTime
  category      String
  description   String?
  amount        Float
  paymentMethod String?
  status        String   @default("PAID")
  businessUnit  String   @default("GENERAL")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ManualPackingItem {
  id          Int      @id @default(autoincrement())
  shipmentId  Int
  description String
  quantity    Int      @default(1)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([shipmentId])
}

model SupplierProduct {
  id           Int      @id @default(autoincrement())
  supplierId   Int
  supplierSku  String?
  supplierName String
  ourSku       String?
  ourProductId Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@unique([supplierId, supplierSku, supplierName])
}

model CompanyAgentRun {
  id            String                @id @default(cuid())
  requestKey    String                @unique
  businessDate  String
  objectiveHash String
  snapshotId    String
  provider      String
  model         String
  responseId    String?
  status        String
  authMode      String
  actorRef      String
  snapshot      Json
  brief         Json
  createdAt     DateTime              @default(now())
  missions      CompanyAgentMission[]

  @@index([createdAt])
  @@index([businessDate])
  @@index([snapshotId])
  @@index([actorRef, createdAt])
}

model CompanyAgentMission {
  id             String                     @id @default(cuid())
  runId          String
  agent          String
  mission        String
  why            String
  expectedOutput String
  status         String                     @default("PLANNED")
  createdAt      DateTime                   @default(now())
  run            CompanyAgentRun            @relation(fields: [runId], references: [id], onDelete: Restrict)
  events         CompanyAgentMissionEvent[]

  @@index([runId])
  @@index([status, createdAt])
}

model CompanyAgentMissionEvent {
  id              String              @id @default(cuid())
  missionId       String
  sequence        Int
  action          String
  fromStatus      String
  toStatus        String
  actorRef        String
  authMode        String
  reason          String?
  deferUntil      DateTime?
  revisionPayload Json?
  incorrectData   Json?
  expectedHead    Int
  idempotencyKey  String
  requestHash     String
  previousHash    String?
  eventHash       String
  createdAt       DateTime            @default(now())
  mission         CompanyAgentMission @relation(fields: [missionId], references: [id], onDelete: Restrict)

  @@unique([missionId, sequence])
  @@unique([missionId, idempotencyKey])
  @@index([missionId, createdAt])
  @@index([toStatus, createdAt])
}

model CompanyAgentRequest {
  id             String   @id @default(cuid())
  requestKey     String
  actorRef       String
  status         String
  leaseToken     String   @unique
  leaseExpiresAt DateTime
  runId          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([requestKey, createdAt])
  @@index([actorRef, createdAt])
}

model CompanyOsCase {
  id                     String                           @id @default(cuid())
  requestId              String                           @unique
  agentId                String                           @default("general-manager-ai-v3")
  area                   String                           @default("GENERAL_MANAGEMENT")
  caseType               String                           @default("ADVISORY")
  scheduleRunKey         String?                          @unique
  objective              String
  objectiveHash          String
  status                 String                           @default("QUEUED")
  actorRef               String
  authMode               String
  relatedCaseId          String?
  inputBudgetEstimate    Int
  maxOutputTokens        Int                              @default(3000)
  targetTotalTokens      Int                              @default(12000)
  webhookDeliveryStatus  String                           @default("PENDING")
  cancellationReason     String?
  maxAttempts            Int                              @default(3)
  maxTurns               Int                              @default(6)
  turnCount              Int                              @default(0)
  nextAttemptAt          DateTime?
  completedAt            DateTime?
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  messages               CompanyOsMessage[]
  events                 CompanyOsCaseEvent[]
  evidence               CompanyOsEvidenceRef[]
  missions               CompanyOsMission[]
  decisions              CompanyOsDecision[]
  usage                  CompanyOsUsage[]
  leases                 CompanyOsLease[]
  heartbeats             CompanyOsHeartbeat[]
  attempts               CompanyOsExecutionAttempt[]
  deliveries             CompanyOsNotificationDelivery[]
  workItems              CompanyOsWorkItem[]
  dependencyObservations CompanyOsDependencyObservation[]

  @@index([status, createdAt])
  @@index([agentId, status, createdAt])
  @@index([agentId, caseType, createdAt])
  @@index([relatedCaseId])
}

model CompanyOsMessage {
  id              String              @id @default(cuid())
  caseId          String
  role            String
  kind            String
  content         String
  actorRef        String
  fromAgentId     String?
  toAgentId       String?
  messageType     String?
  payload         Json                @default("{}")
  schemaVersion   Int                 @default(1)
  evidenceRefs    Json                @default("[]")
  correlationId   String?
  causationId     String?
  deliveryStatus  String              @default("DELIVERED")
  idempotencyKey  String?             @unique
  expectsResponse Boolean             @default(false)
  expiresAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime            @default(now())
  case            CompanyOsCase       @relation(fields: [caseId], references: [id], onDelete: Restrict)
  causedWorkItems CompanyOsWorkItem[] @relation("CausalMessage")

  @@index([caseId, createdAt])
  @@index([fromAgentId, toAgentId, createdAt])
  @@index([correlationId, createdAt])
}

model CompanyOsCaseEvent {
  id             String        @id @default(cuid())
  caseId         String
  sequence       Int
  eventType      String
  fromStatus     String?
  toStatus       String?
  payload        Json
  idempotencyKey String
  previousHash   String?
  eventHash      String
  createdAt      DateTime      @default(now())
  case           CompanyOsCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@unique([caseId, sequence])
  @@unique([caseId, idempotencyKey])
  @@index([caseId, createdAt])
}

model CompanyOsEvidenceRef {
  id          String        @id @default(cuid())
  caseId      String
  evidenceKey String
  sourceRef   String
  value       Json
  critical    Boolean       @default(false)
  observedAt  DateTime?
  createdAt   DateTime      @default(now())
  case        CompanyOsCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@unique([caseId, evidenceKey])
  @@index([caseId, createdAt])
}

model CompanyOsMission {
  id             String              @id @default(cuid())
  caseId         String
  title          String
  rationale      String
  expectedOutput String
  status         String              @default("PLANNED")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  case           CompanyOsCase       @relation(fields: [caseId], references: [id], onDelete: Restrict)
  decisions      CompanyOsDecision[]

  @@unique([id, caseId])
  @@index([caseId, status])
}

model CompanyOsDecision {
  id             String            @id @default(cuid())
  caseId         String
  missionId      String?
  decision       String
  reason         String?
  actorRef       String
  idempotencyKey String            @unique
  createdAt      DateTime          @default(now())
  case           CompanyOsCase     @relation(fields: [caseId], references: [id], onDelete: Restrict)
  mission        CompanyOsMission? @relation(fields: [missionId, caseId], references: [id, caseId], onDelete: Restrict)

  @@index([caseId, createdAt])
}

model CompanyOsAuditEvent {
  id             String   @id @default(cuid())
  requestId      String
  action         String
  actorRef       String
  metadata       Json
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([requestId, createdAt])
}

model CompanyOsUsage {
  id               String                     @id @default(cuid())
  caseId           String
  provider         String
  model            String
  inputTokens      Int
  cachedTokens     Int
  cacheWriteTokens Int                        @default(0)
  outputTokens     Int
  reasoningTokens  Int
  totalTokens      Int
  estimatedCostUsd Decimal                    @db.Decimal(12, 6)
  dailyTotalTokens Int
  dailyCostUsd     Decimal                    @db.Decimal(12, 6)
  alertLevel       Int?
  responseId       String?
  durationMs       Int?
  retries          Int                        @default(0)
  snapshotBytes    Int?
  rulesApplied     Json                       @default("[]")
  attemptId        String?                    @unique
  agentId          String?
  workerId         String?
  outcome          String                     @default("SUCCEEDED")
  createdAt        DateTime                   @default(now())
  case             CompanyOsCase              @relation(fields: [caseId], references: [id], onDelete: Restrict)
  attempt          CompanyOsExecutionAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@index([createdAt])
  @@index([agentId, createdAt])
}

model CompanyOsLock {
  requestId  String   @id
  ownerToken String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([expiresAt])
}

model CompanyOsLease {
  id             String                      @id @default(cuid())
  caseId         String
  requestId      String
  leaseToken     String                      @unique
  ownerRef       String
  workItemId     String?
  agentId        String                      @default("general-manager-ai-v3")
  workerId       String                      @default("legacy-hostinger-company-os-v3")
  instanceId     String                      @default("legacy")
  slotNo         Int?
  renewedAt      DateTime                    @default(now())
  reservedTokens Int                         @default(0)
  status         String                      @default("ACTIVE")
  expiresAt      DateTime
  releasedAt     DateTime?
  createdAt      DateTime                    @default(now())
  case           CompanyOsCase               @relation(fields: [caseId], references: [id], onDelete: Restrict)
  heartbeats     CompanyOsHeartbeat[]
  attempts       CompanyOsExecutionAttempt[]
  workItem       CompanyOsWorkItem?          @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  slot           CompanyOsRuntimeSlot?       @relation(fields: [slotNo], references: [slotNo], onDelete: Restrict)

  @@unique([requestId, leaseToken, caseId])
  @@index([requestId, status, expiresAt])
  @@index([caseId, createdAt])
  @@index([workerId, status, expiresAt])
}

model CompanyOsHeartbeat {
  id         String         @id @default(cuid())
  caseId     String
  requestId  String
  leaseToken String
  workerRef  String
  phase      String
  createdAt  DateTime       @default(now())
  case       CompanyOsCase  @relation(fields: [caseId], references: [id], onDelete: Restrict)
  lease      CompanyOsLease @relation(fields: [requestId, leaseToken, caseId], references: [requestId, leaseToken, caseId], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([caseId])
  @@index([requestId, leaseToken, caseId])
}

model CompanyOsExecutionAttempt {
  id               String             @id @default(cuid())
  caseId           String
  requestId        String
  leaseToken       String
  attempt          Int
  outcome          String
  errorCode        String?
  detail           String?
  workItemId       String?
  agentId          String?
  workerId         String?
  instanceId       String?
  model            String?
  durationMs       Int?
  inputTokens      Int?
  outputTokens     Int?
  totalTokens      Int?
  estimatedCostUsd Decimal?           @db.Decimal(12, 6)
  timeoutAt        DateTime?
  startedAt        DateTime           @default(now())
  finishedAt       DateTime?
  case             CompanyOsCase      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  lease            CompanyOsLease     @relation(fields: [requestId, leaseToken, caseId], references: [requestId, leaseToken, caseId], onDelete: Restrict)
  workItem         CompanyOsWorkItem? @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  usage            CompanyOsUsage?

  @@unique([requestId, attempt])
  @@index([caseId, startedAt])
  @@index([workItemId, startedAt])
  @@index([requestId, leaseToken, caseId])
}

model CompanyOsNotificationDelivery {
  id                  String        @id @default(cuid())
  caseId              String
  requestId           String
  agentId             String        @default("general-manager-ai-v3")
  evidenceFingerprint String?
  assetId             String?
  channel             String
  eventType           String
  status              String
  attempt             Int
  responseCode        Int?
  errorDetail         String?
  idempotencyKey      String        @unique
  createdAt           DateTime      @default(now())
  case                CompanyOsCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([requestId, channel, createdAt])
}

model CompanyOsAgentContract {
  id               String   @id
  agentId          String
  contractVersion  String
  name             String
  reportsToAgentId String?
  domain           String
  handlerKey       String
  status           String
  contract         Json
  createdAt        DateTime @default(now())

  @@unique([agentId, contractVersion])
  @@index([agentId, createdAt])
}

model CompanyOsWorkItem {
  id              String                      @id
  caseId          String
  agentId         String
  triggerType     String
  status          String                      @default("QUEUED")
  priority        Int                         @default(50)
  availableAt     DateTime                    @default(now())
  causalMessageId String?
  inputPayload    Json                        @default("{}")
  schemaVersion   Int                         @default(1)
  idempotencyKey  String                      @unique
  maxAttempts     Int                         @default(3)
  attemptCount    Int                         @default(0)
  timeoutMs       Int                         @default(120000)
  reservedTokens  Int                         @default(12000)
  nextAttemptAt   DateTime?
  completedAt     DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  case            CompanyOsCase               @relation(fields: [caseId], references: [id], onDelete: Restrict)
  causalMessage   CompanyOsMessage?           @relation("CausalMessage", fields: [causalMessageId], references: [id], onDelete: Restrict)
  leases          CompanyOsLease[]
  attempts        CompanyOsExecutionAttempt[]

  @@unique([id, caseId, agentId])
  @@index([status, availableAt, priority, createdAt])
  @@index([caseId, status, createdAt])
  @@index([agentId, status, availableAt])
  @@index([causalMessageId])
}

model CompanyOsRuntimeSlot {
  slotNo     Int              @id
  leaseToken String?
  agentId    String?
  workerId   String?
  expiresAt  DateTime?
  updatedAt  DateTime         @updatedAt
  leases     CompanyOsLease[]
}

model CompanyOsWorker {
  workerId        String                     @id
  instanceId      String
  host            String
  version         String
  state           String
  startedAt       DateTime
  lastHeartbeatAt DateTime
  currentWork     Json                       @default("[]")
  capacity        Int                        @default(2)
  allowedAgentIds String[]                   @default([])
  lastErrorCode   String?
  updatedAt       DateTime                   @updatedAt
  heartbeats      CompanyOsWorkerHeartbeat[]
}

model CompanyOsWorkerHeartbeat {
  id          String          @id
  workerId    String
  instanceId  String
  state       String
  currentWork Json            @default("[]")
  host        String
  version     String
  observedAt  DateTime
  createdAt   DateTime        @default(now())
  worker      CompanyOsWorker @relation(fields: [workerId], references: [workerId], onDelete: Restrict)

  @@index([workerId, observedAt])
}

model CompanyOsDependencyObservation {
  id            String         @id
  dependencyKey String
  status        String
  workerId      String?
  caseId        String?
  latencyMs     Int?
  detail        String?
  observedAt    DateTime
  createdAt     DateTime       @default(now())
  case          CompanyOsCase? @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([dependencyKey, observedAt])
  @@index([caseId])
}

model CompanyOsIncident {
  id              String    @id
  dedupeKey       String    @unique
  type            String
  severity        String
  status          String
  summary         String
  detail          Json      @default("{}")
  occurrenceCount Int       @default(1)
  firstSeenAt     DateTime
  lastSeenAt      DateTime
  notifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, severity, lastSeenAt])
}

model CompanyOsRuntimeControl {
  id                  String   @id
  paused              Boolean  @default(false)
  globalConcurrency   Int      @default(2)
  pollIntervalMs      Int      @default(15000)
  heartbeatIntervalMs Int      @default(60000)
  leaseMs             Int      @default(300000)
  leaseRenewMs        Int      @default(30000)
  shutdownGraceMs     Int      @default(30000)
  updatedBy           String   @default("migration")
  updatedAt           DateTime @updatedAt
}

model CompanyOsWorkerRequestNonce {
  nonce     String   @id
  workerId  String
  endpoint  String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([workerId, createdAt])
  @@index([expiresAt])
}

model CompanyOsEngineeringMission {
  id                 String                                @id
  requestId          String                                @unique
  missionHash        String                                @unique
  objective          String
  repository         String
  baseCommit         String
  allowedPaths       Json
  acceptanceCriteria Json
  autonomyLevel      String
  budgetUsd          Decimal                               @db.Decimal(12, 6)
  spentUsd           Decimal                               @default(0) @db.Decimal(12, 6)
  deadline           DateTime
  policyHash         String
  stateVersion       Int                                   @default(1)
  fencingCounter     BigInt                                @default(0)
  status             String                                @default("DISCOVERED")
  completedAt        DateTime?
  createdAt          DateTime                              @default(now())
  updatedAt          DateTime                              @updatedAt
  capabilityLeases   CompanyOsEngineeringCapabilityLease[]
  events             CompanyOsEngineeringEvent[]
  effects            CompanyOsEngineeringEffect[]

  @@index([status, createdAt])
  @@index([repository, status, createdAt])
}

model CompanyOsEngineeringCapabilityLease {
  id                   String                       @id
  missionId            String
  missionHash          String
  actor                String
  resource             String
  allowedVerbs         Json
  allowedPaths         Json
  autonomyLevel        String
  budgetUsd            Decimal                      @db.Decimal(12, 6)
  policyHash           String
  fencingToken         BigInt                       @default(0)
  expectedStateVersion Int
  status               String                       @default("ACTIVE")
  issuedAt             DateTime                     @default(now())
  expiresAt            DateTime
  revokedAt            DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  mission              CompanyOsEngineeringMission  @relation(fields: [missionId], references: [id], onDelete: Restrict)
  effects              CompanyOsEngineeringEffect[]

  @@unique([missionId, fencingToken])
  @@index([missionId, status, expiresAt])
  @@index([actor, status, expiresAt])
}

model CompanyOsEngineeringEvent {
  id             String                      @id
  missionId      String
  sequence       Int
  eventType      String
  fromStatus     String?
  toStatus       String
  payload        Json
  payloadHash    String
  previousHash   String?
  eventHash      String
  idempotencyKey String
  requestHash    String
  fencingToken   BigInt?
  createdAt      DateTime                    @default(now())
  mission        CompanyOsEngineeringMission @relation(fields: [missionId], references: [id], onDelete: Restrict)

  @@unique([missionId, sequence])
  @@unique([missionId, idempotencyKey])
  @@index([missionId, createdAt])
  @@index([eventType, createdAt])
}

model CompanyOsEngineeringEffect {
  id                 String                              @id
  missionId          String
  capabilityLeaseId  String
  idempotencyKey     String                              @unique
  requestHash        String
  missionHash        String
  targetRepository   String
  verb               String
  targetBaseBranch   String
  targetHeadBranch   String
  targetCommitSha    String
  policyHash         String
  fencingToken       BigInt
  status             String                              @default("PLANNED")
  remoteProvider     String?
  remoteId           String?
  remoteUrl          String?
  remoteReadbackHash String?
  reservedAt         DateTime?
  dispatchStartedAt  DateTime?
  confirmedAt        DateTime?
  reconciledAt       DateTime?
  failedAt           DateTime?
  lastErrorCode      String?
  createdAt          DateTime                            @default(now())
  updatedAt          DateTime                            @updatedAt
  mission            CompanyOsEngineeringMission         @relation(fields: [missionId], references: [id], onDelete: Restrict)
  capabilityLease    CompanyOsEngineeringCapabilityLease @relation(fields: [capabilityLeaseId], references: [id], onDelete: Restrict)

  @@index([missionId, status, createdAt])
  @@index([status, updatedAt])
  @@index([remoteProvider, remoteId])
}

model CompanyOsEngineeringControl {
  id                      String   @id
  pauseIntake             Boolean  @default(true)
  pauseExecution          Boolean  @default(true)
  emergencyStop           Boolean  @default(true)
  quarantinedRepositories String[] @default([])
  disabledActors          String[] @default([])
  updatedBy               String   @default("migration")
  updatedAt               DateTime @updatedAt
}

/// Sanitized projection of a Codex task. Raw conversations never leave the Codex host.
model CompanyOsCodexTask {
  id               String                          @id
  threadId         String                          @unique
  sourceHost       String
  title            String
  projectName      String
  category         String                          @default("GENERAL")
  humanStatus      String                          @default("UNREVIEWED")
  sourceStatus     String                          @default("UNKNOWN")
  priority         Int                             @default(3)
  nextAction       String
  attentionReason  String?
  autonomyLevel    String                          @default("A0")
  codexUrl         String
  fingerprint      String
  sourceUpdatedAt  DateTime
  lastStartedAt    DateTime?
  lastCompletedAt  DateTime?
  lastObservedAt   DateTime
  archived         Boolean                         @default(false)
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  observations     CompanyOsCodexTaskObservation[]
  actions          CompanyOsCodexTaskAction[]
  boardState       CompanyOsCodexTaskBoardState?

  @@index([humanStatus, priority, sourceUpdatedAt])
  @@index([projectName, humanStatus, sourceUpdatedAt])
  @@index([sourceHost, lastObservedAt])
}

/// Human workflow overlay. The Codex collector never writes this table.
model CompanyOsCodexTaskBoardState {
  taskId            String             @id
  workflowStatus    String
  lifecycle         String             @default("OPEN")
  previousLifecycle String?
  sourceFingerprint String
  projectNameOverride String?
  version           Int                @default(0)
  updatedBy         String
  updatedAt         DateTime           @updatedAt
  task              CompanyOsCodexTask @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([lifecycle, workflowStatus, updatedAt])
}

/// Append-only human management action for a Codex task.
model CompanyOsCodexTaskAction {
  id                  String             @id
  taskId              String
  idempotencyKey      String             @unique
  action              String
  fingerprint         String
  requestHash         String
  previousVersion     Int
  newVersion          Int
  previousHumanStatus String
  newHumanStatus      String
  previousLifecycle   String
  newLifecycle        String
  previousProjectName String
  newProjectName      String
  resultSnapshot      Json
  actorRef            String
  createdAt           DateTime           @default(now())
  task                CompanyOsCodexTask @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([taskId, newVersion])
  @@index([taskId, createdAt])
}

/// Append-only evidence that a Codex task materially changed classification.
model CompanyOsCodexTaskObservation {
  id           String             @id
  taskId       String
  fingerprint  String
  humanStatus  String
  sourceStatus String
  actorRef      String
  observedAt   DateTime           @default(now())
  task         CompanyOsCodexTask @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([taskId, fingerprint, humanStatus])
  @@index([observedAt])
}

model CompanyOsCodexInventorySync {
  id            String   @id
  sourceHost    String
  scanId        String
  observedCount Int      @default(0)
  changedCount  Int      @default(0)
  completedAt   DateTime
  createdAt     DateTime @default(now())

  @@index([sourceHost, completedAt])
}

/// Auditable receipt of a supplier price list loaded through ImportSys/Agent OS.
/// This stores load metadata only; it never stores the WhatsApp message or raw file.
model SupplierPriceListLoad {
  id                     String   @id @default(cuid())
  source                 String   @default("IMPORTSYS")
  supplierName           String?
  sourceName             String?
  status                 String   @default("LOADED")
  rowsAnalyzed           Int
  uniqueProductsAnalyzed Int
  probableCount          Int      @default(0)
  possibleCount          Int      @default(0)
  manualReviewCount      Int      @default(0)
  receivedAt             DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([receivedAt])
  @@index([supplierName, receivedAt])
}
