generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id           Int           @id @default(autoincrement())
  old_id       Int?          @unique
  name         String
  document_id  String?
  email        String?
  phone        String?
  instagram    String?
  webpage      String?
  address      String?
  type         String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  city         String?
  country      String?
  state        String?
  zipCode      String?
  userId       String?       @unique
  segment      String?
  canAccess    Boolean       @default(true)
  active       Boolean       @default(true)
  phone2       String?
  user         User?         @relation(fields: [userId], references: [id])
  orders       Order[]
  shipments    Shipment[]
  transactions Transaction[]
  allocations  PurchaseAllocation[]
  accountEvidence AccountEvidence[]
}

model User {
  id        String   @id @default(cuid())
  name      String?
  username  String?  @unique
  email     String?  @unique
  password  String?
  role      String   @default("CLIENT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client?
}

model Product {
  id                 Int            @id @default(autoincrement())
  sku                String         @unique
  name               String
  color_grade        String?
  type               String?
  model              String?
  brand              String?
  weight             Float?
  volum              Float?
  status             String?
  last_purchase_cost Float?
  active             Boolean        @default(true)
  webpage            String?
  lp1                Float?
  lp2                Float?
  lp3                Float?
  description        String?
  stock              Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  imageUrl           String?
  orderItems         OrderItem[]
  purchaseItems      PurchaseItem[]
}

model SparePart {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  name        String
  description String?
  cost        Float?
  price       Float?
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Supplier {
  id           Int           @id @default(autoincrement())
  name         String
  contact      String?
  email        String?
  phone        String?
  address      String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  city         String?
  country      String?
  state        String?
  zipCode      String?
  old_id       Int?          @unique
  orderItems   OrderItem[]
  purchases    Purchase[]
  transactions Transaction[]
}

model Order {
  id              Int         @id @default(autoincrement())
  order_number    Int?        @unique
  clientId        Int
  date            DateTime
  status          String
  total_amount    Float
  currency        String      @default("USD")
  notes           String?
  forwarder       String?
  tracking_number String?
  shipmentId      Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  type            String?
  paymentMethod   String?
  email_sent_at   DateTime?
  source          String?
  client          Client      @relation(fields: [clientId], references: [id])
  shipment        Shipment?   @relation(fields: [shipmentId], references: [id])
  items           OrderItem[]
  allocations     PurchaseAllocation[]
  submissionGuard OrderSubmissionGuard?
}

model OrderSubmissionGuard {
  id            Int      @id @default(autoincrement())
  submissionKey String   @unique
  orderId       Int      @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model OrderItem {
  id               Int       @id @default(autoincrement())
  orderId          Int
  productId        Int?
  productName      String
  quantity         Int
  unit_price       Float
  unit_cost        Float
  shipping_cost    Float?
  subtotal         Float
  profit           Float     @default(0)
  supplierId       Int?
  purchase_invoice String?
  shipmentId       Int?
  status           String?
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product?  @relation(fields: [productId], references: [id])
  shipment         Shipment? @relation(fields: [shipmentId], references: [id])
  supplier         Supplier? @relation(fields: [supplierId], references: [id])
  allocations      PurchaseAllocation[]
}

model Transaction {
  id            Int       @id @default(autoincrement())
  clientId      Int?
  date          DateTime
  type          String
  amount        Float
  description   String?
  reference     String?
  createdAt     DateTime  @default(now())
  paymentMethod String?
  supplierId    Int?
  client        Client?   @relation(fields: [clientId], references: [id])
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  receipt       PaymentReceipt?
  paymentGuard  ClientPaymentGuard?
  accountEvidence AccountEvidence[]
}

model ClientPaymentGuard {
  id           Int         @id @default(autoincrement())
  clientId     Int
  paymentDate  DateTime    @db.Date
  amount       Float
  referenceKey String
  transactionId Int        @unique
  transaction  Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@unique([clientId, paymentDate, amount, referenceKey])
}

model SyncRun {
  id        Int      @id @default(autoincrement())
  scope     String
  status    String
  startedAt DateTime @default(now())
  finishedAt DateTime?
  summary   Json?
  error     String?
  changes   SyncChange[]

  @@index([startedAt])
  @@index([status])
}

model SyncChange {
  id        Int      @id @default(autoincrement())
  syncRunId Int
  entity    String
  entityKey String
  action    String
  reason    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  syncRun   SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  @@index([syncRunId])
  @@index([entity, entityKey])
  @@index([action])
}

model PaymentReceipt {
  id            Int         @id @default(autoincrement())
  transactionId Int         @unique
  fileName      String
  mimeType      String
  size          Int
  sha256        String
  data          Bytes
  createdAt     DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([sha256])
}

model AccountEvidence {
  id            Int          @id @default(autoincrement())
  clientId      Int
  transactionId Int?
  transactionReference String?
  transactionDate DateTime?  @db.Date
  transactionType String?
  transactionAmount Float?
  category      String
  note          String?
  source        String?
  fileName      String?
  mimeType      String?
  size          Int?
  sha256        String?
  data          Bytes?
  createdAt     DateTime     @default(now())
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([transactionId])
  @@index([sha256])
}

model Shipment {
  id              Int         @id @default(autoincrement())
  shipment_number Int?        @unique
  clientId        Int?
  forwarder       String?
  date_shipped    DateTime?
  date_arrived    DateTime?
  weight_fw       Float?
  weight_cli      Float?
  type_load       String?
  item_count      Int?
  cost_total      Float?
  price_total     Float?
  profit          Float?
  invoice         String?
  status          String
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  email_sent_at   DateTime?
  cargo_description String?
  orders          Order[]
  items           OrderItem[]
  client          Client?     @relation(fields: [clientId], references: [id])
}

model Purchase {
  id             Int            @id @default(autoincrement())
  invoice_number String?        @unique
  date           DateTime
  due_date       DateTime?
  supplierId     Int
  total_amount   Float
  paid_amount    Float          @default(0)
  balance_due    Float          @default(0)
  payment_status String         @default("PENDIENTE")
  paid_at        DateTime?
  payment_method String?
  status         String         @default("ABIERTA")
  receipt_url    String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  items          PurchaseItem[]
}

model PurchasePayment {
  id             Int      @id @default(autoincrement())
  purchaseId      Int
  supplierId      Int
  date            DateTime @default(now())
  amount          Float
  payment_method  String?
  reference       String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  paymentGuard    PurchasePaymentGuard?

  @@index([purchaseId, date])
  @@index([supplierId, date])
}

model PurchasePaymentGuard {
  id                Int             @id @default(autoincrement())
  purchaseId        Int
  paymentDate       DateTime        @db.Date
  amount            Float
  referenceKey      String
  purchasePaymentId Int             @unique
  purchasePayment   PurchasePayment @relation(fields: [purchasePaymentId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@unique([purchaseId, paymentDate, amount, referenceKey])
}

model PurchaseItem {
  id          Int      @id @default(autoincrement())
  purchaseId  Int
  sku         String?
  productName String
  quantity    Int
  allocated_quantity Int @default(0)
  unit_cost   Float
  subtotal    Float
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [sku], references: [sku])
  allocations PurchaseAllocation[]
}

model PurchaseAllocation {
  id                  Int          @id @default(autoincrement())
  purchaseItemId      Int
  clientId            Int
  orderId             Int
  orderItemId         Int
  quantity            Int
  unit_cost_snapshot  Float
  unit_price_snapshot Float
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  client              Client       @relation(fields: [clientId], references: [id])
  order               Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem           OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  purchaseItem        PurchaseItem @relation(fields: [purchaseItemId], references: [id], onDelete: Cascade)

  @@index([purchaseItemId])
  @@index([clientId])
  @@index([orderId])
  @@index([orderItemId])
}

model Expense {
  id            Int      @id @default(autoincrement())
  date          DateTime
  category      String
  description   String?
  amount        Float
  paymentMethod String?
  status        String   @default("PAID")
  businessUnit  String   @default("GENERAL")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ManualPackingItem {
  id          Int      @id @default(autoincrement())
  shipmentId  Int
  description String
  quantity    Int      @default(1)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([shipmentId])
}

model SupplierProduct {
  id           Int      @id @default(autoincrement())
  supplierId   Int
  supplierSku  String?
  supplierName String
  ourSku       String?
  ourProductId Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@unique([supplierId, supplierSku, supplierName])
}

model CompanyAgentRun {
  id           String   @id @default(cuid())
  requestKey   String   @unique
  businessDate String
  objectiveHash String
  snapshotId   String
  provider     String
  model        String
  responseId   String?
  status       String
  authMode     String
  actorRef     String
  snapshot     Json
  brief        Json
  createdAt    DateTime @default(now())
  missions     CompanyAgentMission[]

  @@index([createdAt])
  @@index([businessDate])
  @@index([snapshotId])
  @@index([actorRef, createdAt])
}

model CompanyAgentMission {
  id             String          @id @default(cuid())
  runId          String
  agent          String
  mission        String
  why            String
  expectedOutput String
  status         String          @default("PLANNED")
  createdAt      DateTime        @default(now())
  run            CompanyAgentRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([runId])
  @@index([status, createdAt])
}

model CompanyAgentRequest {
  id             String   @id @default(cuid())
  requestKey     String
  actorRef       String
  status         String
  leaseToken     String   @unique
  leaseExpiresAt DateTime
  runId          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([requestKey, createdAt])
  @@index([actorRef, createdAt])
}
